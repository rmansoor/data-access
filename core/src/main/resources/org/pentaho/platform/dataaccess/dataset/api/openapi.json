{
  "openapi": "3.1.0",
  "info": {
    "title": "Pentaho Datasets API",
    "version": "2.0",
    "description": "Create, change, share, validate and publish datasets: a source (database tables, a SQL query or an uploaded file), its columns, an optional model, row-level security and refresh settings.\n\nEvery read returns the dataset's version as an ETag. Every update and delete must send it back as If-Match; the server refuses with 412 if the dataset changed in between, and with 428 if If-Match is missing. Sharing has its own ETag. Errors are always JSON (see Error), never an HTML page; clients switch on `code`, which never changes meaning.\n\nThe v1 data source endpoints are unchanged."
  },
  "servers": [{ "url": "/pentaho/plugin", "description": "This Pentaho server" }],
  "tags": [
    { "name": "Datasets" },
    { "name": "Sharing" },
    { "name": "About this API" }
  ],
  "paths": {
    "/data-access/api/v2/datasets": {
      "get": {
        "tags": ["Datasets"],
        "operationId": "listDatasets",
        "summary": "List the datasets you can see, by name",
        "responses": {
          "200": { "description": "The datasets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetList" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "post": {
        "tags": ["Datasets"],
        "operationId": "createDataset",
        "summary": "Create a draft dataset",
        "description": "Only `name` is required for a draft. Without an `id`, one is made from the name (\"Monthly orders\" becomes `monthly-orders`, then `monthly-orders-2`). The owner defaults to you.",
        "requestBody": { "$ref": "#/components/requestBodies/Definition" },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": { "description": "The new dataset's address", "schema": { "type": "string" } },
              "ETag": { "$ref": "#/components/headers/ETag" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetDefinition" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidDefinition" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/AlreadyExists" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Datasets"],
        "operationId": "getDataset",
        "summary": "Read a dataset",
        "description": "A dataset shared restrictively with others answers 404 to you, as if it did not exist.",
        "parameters": [{ "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": {
          "200": {
            "description": "The definition",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetDefinition" } } }
          },
          "304": { "description": "Unchanged since the version named in If-None-Match" },
          "400": { "$ref": "#/components/responses/InvalidDefinition" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "put": {
        "tags": ["Datasets"],
        "operationId": "updateDataset",
        "summary": "Replace a dataset's definition",
        "description": "The `id` can't change. Leaving `owner` out keeps the current owner; only the owner or an administrator can hand the dataset to someone else.",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/Definition" },
        "responses": {
          "200": {
            "description": "Updated",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetDefinition" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidDefinition" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "delete": {
        "tags": ["Datasets"],
        "operationId": "deleteDataset",
        "summary": "Delete a dataset",
        "description": "The dataset goes to the repository trash and can be restored from there.",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "responses": {
          "204": { "description": "Deleted" },
          "400": { "$ref": "#/components/responses/InvalidDefinition" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/validate": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "tags": ["Datasets"],
        "operationId": "validateDataset",
        "summary": "List what still blocks publishing",
        "responses": {
          "200": { "description": "The result; `valid` is false when there are problems", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Validation" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/acl": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Sharing"],
        "operationId": "getDatasetSharing",
        "summary": "Read who the dataset is shared with",
        "responses": {
          "200": {
            "description": "The sharing",
            "headers": { "ETag": { "$ref": "#/components/headers/SharingETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sharing" } } }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "put": {
        "tags": ["Sharing"],
        "operationId": "setDatasetSharing",
        "summary": "Change who the dataset is shared with",
        "description": "Only the owner or an administrator may. A restricted dataset always keeps its owner, with WRITE access. Send `{\"restricted\": false}` to share with everyone again.",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sharing" } } }
        },
        "responses": {
          "200": {
            "description": "The sharing as stored",
            "headers": { "ETag": { "$ref": "#/components/headers/SharingETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sharing" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/sample": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "tags": ["Datasets"],
        "operationId": "sampleDataset",
        "summary": "Read the first rows of the dataset's source",
        "description": "Columns as the source reports them, and up to `limit` rows. SQL must be a single read-only query; it runs on a read-only connection in a transaction that is rolled back, with a 30-second timeout. Values are strings, numbers, booleans, ISO-8601 dates and timestamps, or null.",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "description": "Rows wanted, 1 to 1000", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } },
          { "name": "table", "in": "query", "required": false, "description": "For a TABLES source, which of its tables (as listed in the definition); the first by default", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The sample", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sample" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "description": "`validation-failed`: the source isn't complete or its SQL isn't a single read-only query (`path` names the field). `source-failed`: the database or file refused or failed, or the query took too long.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/file": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "put": {
        "tags": ["Datasets"],
        "operationId": "uploadDatasetFile",
        "summary": "Upload the dataset's CSV file, Excel workbook or Parquet file",
        "description": "The request body is the file itself, sent as is (any content type, such as text/csv). The server stores it under a name it chooses, in a folder for the dataset that isn't served to browsers, and sets `source.file.path` and `source.file.originalName`. A dataset without a source gets a FILE source (CSV, header row). The file it replaces is deleted; the staging table stays until the next load. The largest file accepted is set by `data-access-dataset-upload-max-mb` (500 MB by default).",
        "parameters": [
          { "$ref": "#/components/parameters/IfMatch" },
          { "name": "name", "in": "query", "required": false, "description": "The file's name on the uploader's computer: .csv, .txt or .tsv, .xlsx for an Excel workbook (source.file.format becomes XLSX; an old .xls is refused) or .parquet for a Parquet file (PARQUET; its columns and types come from its schema)", "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "*/*": { "schema": { "type": "string", "format": "binary" } } } },
        "responses": {
          "200": { "description": "Stored", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetDefinition" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "413": { "description": "`too-large`: the file is larger than the server accepts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "415": { "description": "`unsupported-file`: not a .csv, .txt, .tsv, .xlsx or .parquet file, empty, not text, or not the workbook or Parquet file its name says", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/stage": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "tags": ["Datasets"],
        "operationId": "stageDataset",
        "summary": "Load the dataset's uploaded file into a staging table",
        "description": "For a FILE source only. Reads the whole file and checks every value against the type detected from its first lines; a column with a value that doesn't fit is loaded as text and reported in `warnings`. Then creates a new table on the staging connection (`data-access-staging-jndi`), loads every row in one transaction, and points the dataset at it. Columns the definition lists are loaded as the type it gives them (values that don't fit load as empty and are counted in `warnings`); other columns use the detected type (`source.connection`, `source.file.stagingTable`). The table the dataset used before is dropped. If the load fails, the dataset is unchanged.",
        "parameters": [
          { "$ref": "#/components/parameters/IfMatch" },
          { "name": "async", "in": "query", "required": false, "description": "true: answer 202 with a job at once and load in the background (follow it with GET, stop it with DELETE)", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "202": { "description": "Started in the background (async=true)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoadJob" } } } },
          "200": { "description": "Loaded", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagedTable" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "`already-exists`: a background load of this dataset is running", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "422": { "description": "`validation-failed`: the file settings aren't complete, or `source.connection` names a connection other than the staging one. `source-failed`: the file couldn't be read or has too many rows, or the staging database refused the load.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      },
      "get": {
        "tags": ["Datasets"],
        "operationId": "getDatasetLoad",
        "summary": "Follow the dataset's background load",
        "description": "The running or last background load: rows read and loaded so far, then how it ended. Kept in memory: a server restart forgets it.",
        "responses": {
          "200": { "description": "The load", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoadJob" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "delete": {
        "tags": ["Datasets"],
        "operationId": "cancelDatasetLoad",
        "summary": "Stop the dataset's background load",
        "description": "It stops within the next thousand rows, drops what it loaded and leaves the dataset as it was.",
        "responses": {
          "202": { "description": "Asked to stop", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoadJob" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/publish": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": {
        "tags": ["Datasets"],
        "operationId": "publishDataset",
        "summary": "Publish the dataset for reports and analysis",
        "description": "Generates the metadata domain (XMI) for Interactive Reports and Report Designer and, when the model has measures, the Mondrian schema for Analyzer, the way the Data Source Wizard did, and stores them (replacing an earlier publish). A definition without a model gets the Agile BI modeler's suggestion. The domain id, model id and catalog name are fixed on the first publish (from the dataset's id and name, made unique against other data sources) and kept in `legacy`, so the version changes then; renaming the dataset later doesn't change them. A FILE source must be loaded first; a TABLES source must name one table. Republishing an unchanged definition writes identical files.",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "responses": {
          "200": {
            "description": "Published",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Published" } } }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "412": { "$ref": "#/components/responses/StaleVersion" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "428": { "$ref": "#/components/responses/VersionRequired" },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/datasets/{id}/model/suggestion": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Datasets"],
        "operationId": "suggestDatasetModel",
        "summary": "Suggest a model for the dataset",
        "description": "The Agile BI modeler's suggestion for the kept columns, as the Data Source Wizard made it: every column a dimension, numeric columns also a summed measure. Same shape as `model` in the definition; nothing is stored. A FILE source must be loaded first.",
        "responses": {
          "200": { "description": "The suggested model", "content": { "application/json": { "schema": { "$ref": "dataset-definition.schema.json#/$defs/model" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/connections/{name}/tables": {
      "parameters": [{ "name": "name", "in": "path", "required": true, "description": "A database connection's name", "schema": { "type": "string" } }],
      "get": {
        "tags": ["Datasets"],
        "operationId": "listConnectionTables",
        "summary": "List the tables and views on a connection",
        "description": "For choosing a TABLES source. Sorted by schema and name, leaving out the database's own catalog schemas; at most 5000. Read-only, with the same timeout as sampling. Needs the permission to manage datasets.",
        "responses": {
          "200": { "description": "The tables", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TableList" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "description": "`validation-failed`: no connection has that name. `source-failed`: the database refused or failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/settings/staging": {
      "get": {
        "tags": ["Datasets"],
        "operationId": "getStagingSettings",
        "summary": "Where uploaded files are loaded",
        "description": "The connection and schema in effect, what an administrator saved, and the defaults from data-access/settings.xml (`data-access-staging-jndi`, `data-access-staging-schema`) used for anything not saved. Needs the permission to manage datasets.",
        "responses": {
          "200": { "description": "The settings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingState" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      },
      "put": {
        "tags": ["Datasets"],
        "operationId": "setStagingSettings",
        "summary": "Change where uploaded files are loaded",
        "description": "Administrators only. Empty values go back to the settings.xml defaults. The connection must be one the server can open. Datasets already loaded keep their tables until they are next loaded, which moves them.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingSettings" } } } },
        "responses": {
          "200": { "description": "Saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StagingState" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/Internal" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    },
    "/data-access/api/v2/openapi.json": {
      "get": {
        "tags": ["About this API"],
        "operationId": "getOpenApi",
        "summary": "This document",
        "security": [],
        "responses": { "200": { "description": "OpenAPI 3.1", "content": { "application/json": {} } } }
      }
    },
    "/data-access/api/v2/dataset-definition.schema.json": {
      "get": {
        "tags": ["About this API"],
        "operationId": "getDefinitionSchema",
        "summary": "The JSON Schema of a dataset definition",
        "security": [],
        "responses": { "200": { "description": "JSON Schema 2020-12", "content": { "application/schema+json": {} } } }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id", "in": "path", "required": true,
        "description": "The dataset's id: letters, digits, '.', '-' and '_', starting with a letter or digit, at most 100 characters",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$" }
      },
      "IfMatch": {
        "name": "If-Match", "in": "header", "required": true,
        "description": "The ETag from your last read. `*` means whatever is current (use with care). Weak tags (W/\"…\") are accepted.",
        "schema": { "type": "string" }
      },
      "IfNoneMatch": {
        "name": "If-None-Match", "in": "header", "required": false,
        "description": "An ETag you hold; answers 304 if the dataset still has that version",
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "ETag": { "description": "The dataset's version; send it back as If-Match", "schema": { "type": "string" } },
      "SharingETag": { "description": "The sharing's version (starts with `acl-`); send it back as If-Match", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "Definition": {
        "required": true,
        "description": "A dataset definition. Drafts may leave out everything but `name`; validate lists what publishing needs.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DatasetDefinition" } } }
      }
    },
    "responses": {
      "InvalidDefinition": { "description": "`invalid-definition`: the body is not a readable definition, or the id is not valid. `path` names the field.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidRequest": { "description": "`invalid-request`: the body can't be read. `path` names the field.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationFailed": { "description": "`validation-failed`: readable but incomplete or inconsistent; see `problems`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "`forbidden`: you don't have permission", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "`not-found`: no such dataset, or none you may see", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "AlreadyExists": { "description": "`already-exists`: the id is taken", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "StaleVersion": { "description": "`stale-version`: it changed since you read it; read it again and reapply your change", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "VersionRequired": { "description": "`version-required`: send If-Match", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotImplemented": { "description": "`not-implemented`: planned but not built yet", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Internal": { "description": "`internal`: something else went wrong; the details are in the server log", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "DatasetDefinition": { "$ref": "dataset-definition.schema.json" },
      "Published": {
        "type": "object",
        "required": ["domainId", "modelId", "catalogName", "analysis", "warnings"],
        "properties": {
          "domainId": { "type": "string", "description": "The metadata domain, as Interactive Reports and Report Designer name it" },
          "modelId": { "type": "string", "description": "The reporting model in the domain" },
          "catalogName": { "type": "string", "description": "The Mondrian catalog, also the cube's name in Analyzer" },
          "analysis": { "type": "boolean", "description": "Whether a Mondrian catalog was published (the model has measures)" },
          "warnings": { "type": "array", "items": { "type": "string" }, "description": "What was published differently from the definition" }
        }
      },
      "DatasetList": {
        "type": "object",
        "required": ["datasets"],
        "properties": {
          "datasets": { "type": "array", "items": { "$ref": "#/components/schemas/DatasetSummary" } }
        }
      },
      "DatasetSummary": {
        "type": "object",
        "required": ["id", "name", "version", "updated"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "sourceType": { "type": "string", "enum": ["TABLES", "SQL", "FILE"] },
          "version": { "type": "string", "description": "The same value as the dataset's ETag" },
          "updated": { "type": "string", "format": "date-time" },
          "published": {
            "type": "object",
            "description": "Present once the dataset has been published: the names reports find it by",
            "properties": { "domainId": { "type": "string" }, "catalogName": { "type": "string" } }
          }
        }
      },
      "Sample": {
        "type": "object",
        "required": ["columns", "rows", "truncated"],
        "properties": {
          "columns": { "type": "array", "items": { "$ref": "#/components/schemas/SourceColumn" } },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number", "boolean", "null"] } } },
          "truncated": { "type": "boolean", "description": "The source has more rows than were returned" },
          "sheets": { "type": "array", "items": { "type": "string" }, "description": "An Excel workbook's sheets, in order, so the one to read (source.file.sheet) can be chosen; absent for other sources" }
        }
      },
      "SourceColumn": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["STRING", "INTEGER", "DECIMAL", "BOOLEAN", "DATE", "TIMESTAMP"] },
          "sourceType": { "type": "string", "description": "The database's type name, or for a file the detected format mask" },
          "nullable": { "type": "boolean" },
          "table": { "type": "string", "description": "For a TABLES source, the table the column belongs to" }
        }
      },
      "StagedTable": {
        "type": "object",
        "required": ["connection", "table", "rows", "columns", "warnings"],
        "properties": {
          "connection": { "type": "string", "description": "The staging connection" },
          "table": { "type": "string", "description": "The new table, as `schema.table` when a staging schema is set" },
          "rows": { "type": "integer", "minimum": 0 },
          "columns": { "type": "array", "items": { "$ref": "#/components/schemas/StagedColumn" } },
          "warnings": { "type": "array", "items": { "type": "string" }, "description": "What was loaded differently from what was detected; at most 20" }
        }
      },
      "StagedColumn": {
        "type": "object",
        "required": ["sourceName", "name", "type", "sqlType"],
        "properties": {
          "sourceName": { "type": "string", "description": "The column's name in the file" },
          "name": { "type": "string", "description": "The column's name in the table: letters, digits and underscores" },
          "type": { "type": "string", "enum": ["STRING", "INTEGER", "DECIMAL", "BOOLEAN", "DATE", "TIMESTAMP"] },
          "sqlType": { "type": "string", "description": "The type the column was created with, in the staging database's terms" }
        }
      },
      "TableList": {
        "type": "object",
        "required": ["tables", "truncated"],
        "properties": {
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "qualifiedName"],
              "properties": {
                "schema": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string", "description": "TABLE or VIEW" },
                "qualifiedName": { "type": "string", "description": "`schema.name`, or `name` without a schema: what a TABLES source lists" }
              }
            }
          },
          "truncated": { "type": "boolean", "description": "The connection has more tables than were listed" }
        }
      },
      "StagingSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connection": { "type": "string", "description": "A database connection's name" },
          "schema": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,127}$" }
        }
      },
      "StagingState": {
        "type": "object",
        "required": ["saved", "defaults"],
        "properties": {
          "connection": { "type": "string", "description": "In effect" },
          "schema": { "type": "string", "description": "In effect" },
          "saved": { "$ref": "#/components/schemas/StagingSettings" },
          "defaults": { "$ref": "#/components/schemas/StagingSettings" }
        }
      },
      "LoadJob": {
        "type": "object",
        "required": ["id", "datasetId", "state", "rowsRead", "rowsLoaded", "started"],
        "properties": {
          "id": { "type": "string" },
          "datasetId": { "type": "string" },
          "state": { "type": "string", "enum": ["RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
          "rowsRead": { "type": "integer", "description": "Rows checked so far (first pass), updated every thousand rows" },
          "rowsLoaded": { "type": "integer", "description": "Rows inserted so far (second pass), updated every thousand rows" },
          "started": { "type": "string", "format": "date-time" },
          "finished": { "type": "string", "format": "date-time" },
          "table": { "$ref": "#/components/schemas/StagedTable" },
          "version": { "type": "string", "description": "When it succeeded: the dataset's new version (ETag)" },
          "error": { "$ref": "#/components/schemas/Error" }
        }
      },
      "Validation": {
        "type": "object",
        "required": ["valid", "problems"],
        "properties": {
          "valid": { "type": "boolean" },
          "problems": { "type": "array", "items": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "Sharing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "restricted": { "type": "boolean", "default": false, "description": "false: everyone with the data-access view permission. true: only the entries, the owner and administrators." },
          "entries": { "type": "array", "maxItems": 500, "items": { "$ref": "#/components/schemas/ShareEntry" } }
        },
        "example": { "restricted": true, "entries": [{ "recipient": "suzy", "type": "USER", "access": "WRITE" }, { "recipient": "Sales", "type": "ROLE", "access": "READ" }] }
      },
      "ShareEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient", "type", "access"],
        "properties": {
          "recipient": { "type": "string", "minLength": 1, "maxLength": 255 },
          "type": { "type": "string", "enum": ["USER", "ROLE"] },
          "access": { "type": "string", "enum": ["READ", "WRITE"], "description": "READ: see and use it. WRITE: also change and delete it." }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["path", "message"],
        "properties": {
          "path": { "type": "string", "description": "The field at fault, such as `columns[1].name`; empty for the whole body" },
          "message": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["invalid-definition", "invalid-request", "validation-failed", "source-failed", "forbidden", "not-found", "already-exists", "stale-version", "version-required", "too-large", "unsupported-file", "not-implemented", "internal"]
          },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "problems": { "type": "array", "items": { "$ref": "#/components/schemas/Problem" } }
        }
      }
    }
  }
}
